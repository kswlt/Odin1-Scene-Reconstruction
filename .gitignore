# --- Odin / ROS build artifacts ---
workspace/build/
workspace/install/
workspace/log/
build/
install/
log/
*.pyc
__pycache__/

# --- Captured data (large, NOT for git) ---
data/raw/
data/recorddata/
data/maps/
data/pointcloud/
data/images/
data/mesh/
data/gaussian/
*.bag
*.db3
*.mcap
*.ply
*.pcd
*.las
*.laz
*.bin
*.olx
*.lx

# --- Local staging / ROS workspace ---
# Firmware payloads, vendor clones, build output, and runtime logs stay local.
# Keep only the small first-party live-map preview package in version control.
.staging/
workspace/*
!workspace/src/
workspace/src/*
!workspace/src/map_preview/
!workspace/src/map_preview/**

# --- Logs ---
logs/
*.log

# --- Secrets & credentials ---
.env
*.pem
*.key
id_ed25519
id_rsa

# --- OS / editor ---
Thumbs.db
.DS_Store
.vscode/
.idea/
